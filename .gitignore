# Environment and credentials
# NOTE: .env is intentionally tracked because it only contains Vite public vars
# (VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY) which are anon/publishable
# keys safe to expose in the client bundle. Production builds need them committed.
.env.local
.env.*.local
!.env.example
*.pem
*.key
service-account*.json
credentials*.json

# Supabase CLI local state
supabase/.temp/

